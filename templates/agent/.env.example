# Copy to .env and fill in. .env is git-ignored. The kit does not load it itself:
# export the variables, or run through uv: uv run --env-file .env agentkit run ...

# Credentials for the provider your model roles use.
ANTHROPIC_API_KEY=

# To use a model served by LM Studio or Ollama instead:
# MODEL_PROVIDER=local
# LOCAL_MODEL_ID=               # an ID from `agentkit models list --local`
