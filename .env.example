# Every environment variable the kit reads. Copy to .env and fill in; .env is git-ignored.

# Selects agentkit.<env>.yaml and sets `env` in the config.
AGENTKIT_ENV=dev

# Any config key can be overridden: AGENTKIT_ prefix, `__` between nesting levels.
# AGENTKIT_LIMITS__MAX_STEPS=10

# Provider credentials. Only the providers your model roles use are needed.
# The Anthropic SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=

# Set to `local` to move every hosted model role to the local model server.
# MODEL_PROVIDER=local
# Same switch for one agent, named after it, for example for the agent `triage`:
# TRIAGE_MODEL_PROVIDER=local

# Local model server (LM Studio, Ollama or compatible). No cloud key is needed.
# LOCAL_API_BASE=http://127.0.0.1:1234/v1   # include the port and /v1
# LOCAL_MODEL_ID=                           # exact ID from `agentkit models list --local`
# LOCAL_API_KEY=                            # optional; a placeholder is sent when unset
